# Bazel build outputs
# No trailing slash: Bazel's root output entries are symlinks, which
# directory-only patterns (ending in "/") do not match.
/bazel-*

# Bazel cache
.bazel-cache/
.bazelrc.local
.bazelrc.ci

# Build artifacts
build/
dist/
*.o
*.a
*.so
*.dylib

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Docker
.env
docker-compose.override.yml

# Logs
*.log

# Profile data
*.gz
profile_report.txt

# Temporary files
/tmp/
*.tmp
